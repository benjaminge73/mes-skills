{
  "description": "Garde-fous du plugin plans-notion : pas de --no-verify sur un commit, pas de Statut de plan Notion accentué. Rappel après ExitPlanMode : déléguer chaque étape à l'executant (silencieux si le plan cite une page Notion).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/rappel_delegation.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refuser_no_verify.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__notion-update-page|mcp__.*__notion-create-pages",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/refuser_statut_accentue.py\""
          }
        ]
      }
    ]
  }
}
